# Serviço único para homeserver.local e o IP da LAN.
# O IP pode ser configurado via LAN_IP (compose) — default 192.168.0.10.

# HTTP/1.1 apenas: Caddy 2.11 (Go net/http2 novo) derruba streams h2
# concorrentes do browser (status 0 no log de acesso) — widgets ficam "-".
{
	servers {
		protocols h1
	}
}

homeserver.local {$LAN_IP:192.168.0.10} {
	# Certificado da CA interna (gerado por `hs tls init` em /srv/config/tls).
	tls /etc/tls/server.pem /etc/tls/server.key

	# Assets de config da Homepage sempre revalidados (sem cache heurístico
	# no navegador — custom.css/js editados aparecem sem hard-refresh).
	# Obs: o path matcher do Caddy não aceita wildcard no meio ("custom.*");
	# usar matcher nomeado com os paths exatos.
	@homepage_custom path /api/config/custom.css /api/config/custom.js
	handle @homepage_custom {
		header >Cache-Control "no-cache"
		reverse_proxy homepage:3000
	}

	# Documento HTML da raiz sempre revalidado — o Next manda
	# s-maxage=31536000, e o navegador guardava o HTML antigo sem
	# revalidar (a tab bar e os cards novos não apareciam).
	@homepage_root path /
	handle @homepage_root {
		header >Cache-Control "no-cache"
		reverse_proxy homepage:3000
	}

	# Files (FileBrowser Quantum) — baseURL /files no próprio app
	handle /files/* {
		reverse_proxy files:80
	}

	# Gitea (remove /git)
	handle_path /git/* {
		reverse_proxy gitea:3000
	}

	# HomeServer App (preserva /app)
	handle /app* {
		reverse_proxy api:8000
	}

	# Telemetria read-only: GETs de leitura SEM header de autorização
	# recebem o token de serviço (widgets do portal fazem fetch pelo
	# navegador, e `http://api:8000` não resolve fora da rede Docker).
	# Requests autenticados (App/sessões) passam intactos.
	@api_anon_get {
		path /api/v1/status /api/v1/hardware /api/v1/power/status /api/v1/devices /api/v1/storage /api/v1/storage/status /api/v1/events /api/v1/services/status
		method GET
		not header Authorization *
	}
	handle @api_anon_get {
		reverse_proxy api:8000 {
			header_up Authorization "Bearer {env.API_SERVICE_TOKEN}"
		}
	}

	# API do HomeServer (preserva /api/v1)
	handle /api/v1* {
		reverse_proxy api:8000
	}

	# Homepage (padrão)
	handle {
		reverse_proxy homepage:3000
	}
}

# CA local para download (porta 80) — instale nos dispositivos antes de
# confiar no HTTPS. Serve /hs-ca.pem -> /etc/tls/ca.pem.
http://homeserver.local, http://{$LAN_IP:192.168.0.10} {
	@ca path /hs-ca.pem
	handle @ca {
		root * /etc/tls
		uri replace /hs-ca.pem /ca.pem
		file_server
	}

	handle {
		redir https://{host}{uri} permanent
	}
}
