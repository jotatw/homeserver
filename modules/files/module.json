{
  "id": "files",
  "contractVersion": 1,
  "version": "1.5.3",
  "title": "Files (Quantum)",
  "description": "Gerenciador de arquivos web — acesso e administração do storage.",
  "classification": "service",
  "capabilities": ["files.access", "files.manage"],
  "dependencies": ["storage.persistent"],
  "resources": [
    {"kind": "volume", "ref": "config", "path": "/srv/services/files/config"},
    {"kind": "volume", "ref": "database", "path": "/srv/services/files/database"},
    {"kind": "mount", "ref": "storage", "path": "/srv/storage"}
  ],
  "integrations": [
    {"kind": "route", "path": "/files"},
    {"kind": "adapter", "ref": "filebrowser"}
  ],
  "operations": ["start", "stop", "restart", "enable", "disable", "update", "status"],
  "implementation": {
    "engine": "docker-compose",
    "path": "compose.yaml",
    "compatible": ["hs>=1.0.0"]
  },
  "health": {"kind": "http", "port": 8080, "path": "health"}
}
