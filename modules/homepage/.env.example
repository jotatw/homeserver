# Timezone
TZ=America/Sao_Paulo

# Usuário Docker (PUID/PGID)
# PGID deve ser o grupo do docker.sock para acesso ao socket.
PUID=1000
PGID=989

# HTTP Port
HOMEPAGE_PORT=3000

# Hosts permitidos (separados por vírgula). Padrão: homeserver.local
HOMEPAGE_ALLOWED_HOSTS=homeserver.local

# ============================================================
# Autenticação OIDC (login via Gitea) — ATIVAR QUANDO A
# VERSÃO DO HOMEPAGE PASSAR A SUPORTAR (hoje só na branch dev).
#
# Para ativar, preencha os valores abaixo, troque
# HOMEPAGE_AUTH_ENABLED para true e atualize a imagem.
#
# No Gitea: Settings -> Applications -> OAuth2 Applications
#   Redirect URI: http://<IP_DO_SERVIDOR>:3000/api/auth/callback/homepage-oidc
# ============================================================

# HOMEPAGE_AUTH_ENABLED=true
# HOMEPAGE_AUTH_SECRET=gerar_com_openssl_rand_-hex_32
# HOMEPAGE_EXTERNAL_URL=http://<IP_DO_SERVIDOR>:3000
# HOMEPAGE_OIDC_ISSUER=http://<IP_DO_SERVIDOR>:3001
# HOMEPAGE_OIDC_CLIENT_ID=<client_id_do_gitea>
# HOMEPAGE_OIDC_CLIENT_SECRET=<client_secret_do_gitea>
