# Homepage — configuração do módulo
# Copie para `.env` no diretório do módulo e ajuste.

# Fuso horário
TZ=America/Sao_Paulo

# Usuário/Grupo do processo (coincidem com o usuário principal do servidor)
PUID=1000
PGID=1000

# Hosts permitidos (mDNS local)
HOMEPAGE_ALLOWED_HOSTS=homeserver.local

# Autenticação própria da Homepage (opcional)
HOMEPAGE_AUTH_ENABLED=false
HOMEPAGE_AUTH_SECRET=

# URL externa (opcional)
HOMEPAGE_EXTERNAL_URL=

# OIDC (opcional)
HOMEPAGE_OIDC_ISSUER=
HOMEPAGE_OIDC_CLIENT_ID=
HOMEPAGE_OIDC_CLIENT_SECRET=

# Token de API usado pelos widgets do sistema (substitui {{HOMEPAGE_VAR_API_TOKEN}}
# no services.yaml). Gere em HomeServer App → Administração → Tokens.
# Ex.: hs_token_<hex>
HOMEPAGE_VAR_API_TOKEN=