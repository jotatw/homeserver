# HomeServer API — variáveis de ambiente
#
# Este arquivo é a referência (não versionado). O install.sh gera o .env
# automaticamente a partir destas variáveis. Ajuste manualmente apenas
# se não usar o instalador.

# Fuso horário
TZ=America/Sao_Paulo

# URL interna do FileBrowser (resolvida pela rede docker "homeserver")
FILEBROWSER_URL=http://filebrowser:80

# Usuário administrador do FileBrowser (criado/gerenciado pelo core)
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASS=

# IP do servidor na rede local (usado pela API/core)
HS_HOST_IP=

# Token de serviço para integrações internas (ex.: homepage). Gerado pelo install.sh.
HS_SERVICE_TOKEN=

# Chave SSH do host para o update (git). Caminho absoluto — opcional.
HS_SSH_KEY=
